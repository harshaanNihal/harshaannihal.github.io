{
  "name": "harshaannihal-portfolio",
  "private": true,
  "type": "module",
  "workspaces": [
    "site",
    "api",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w site",
    "dev:api": "npm run dev -w api",
    "build": "npm run build -w site",
