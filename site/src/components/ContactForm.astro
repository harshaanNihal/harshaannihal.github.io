---
/* The contact form, for anyone who'd rather not open a mail app. It posts to the API, which emails the owner. The
   honeypot field is hidden from people and from screen readers; only a bot fills it in. */
import { limits } from '@portfolio/contract';
import { apiUrl } from '../lib/api';
import { profile } from '../lib/data';
import Icon from './Icon.astro';
---
{apiUrl && (
  <form class="contact-form reveal" id="contact-form" method="post" action={`${apiUrl}/contact`} data-contact-form data-email={profile.email}>
    <h3 class="contact-form__title">Or leave a message</h3>
    <div class="contact-form__row">
      <label for="cf-name">Name</label>
      <input id="cf-name" name="name" type="text" autocomplete="name" required maxlength={limits.name} />
    </div>
    <div class="contact-form__row">
      <label for="cf-email">Email</label>
      <input id="cf-email" name="email" type="email" autocomplete="email" required maxlength={limits.email} />
    </div>
    <div class="contact-form__row contact-form__row--wide">
      <label for="cf-message">Message</label>
      <textarea id="cf-message" name="message" rows="5" required minlength={limits.messageMin} maxlength={limits.message}></textarea>
    </div>
    <div class="visually-hidden" aria-hidden="true">
      <label for="cf-website">Leave this empty</label>
      <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <input type="hidden" name="shown" value="" />
    <div class="contact-form__foot">
      <button class="btn btn--ghost contact-form__send" type="submit"><span class="btn__label">Send message</span><span class="btn__icon btn__icon--arrow-right"><Icon name="arrow-right" px={18} /></span></button>
      <p class="contact-form__status" data-form-status role="status" aria-live="polite"></p>
    </div>
    <p class="contact-form__note">It goes straight to my inbox. <a href="/privacy/">How messages are handled</a>.</p>
  </form>
)}
