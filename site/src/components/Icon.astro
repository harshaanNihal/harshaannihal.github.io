}

const { name, px = 20 } = Astro.props;
---
<svg class="icon" width={px} height={px} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={shapes[name]} />
