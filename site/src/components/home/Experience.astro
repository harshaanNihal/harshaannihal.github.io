---
/* Where he has worked, as a ledger on the timeline: dates in a column that never moves, one star on the dashed
   line per row, then the company, title, notes and stack. A role's system opens under its notes, in a details
   element: its name, its sketch as a constellation, and how it was built. The top row is the open slot for the
   next role, and the last is the side projects. Each row carries the skills it used (data-skills, slugified);
   the skills-sky script lights those stars and joins them. Without JavaScript the ledger and the full list of
   skills still read in full. */
import { profile as p } from '../../lib/data';
import { isoMonth, monthYear, slugify } from '../../lib/format';
import Icon from '../Icon.astro';
import SkillSky from '../SkillSky.astro';
import Sketch from '../Sketch.astro';

const escape = (text: string) => text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

/* A note that mentions the press piece links those words to it. */
function noteHtml(note: string, press?: { match: string; url: string }): string {
  const html = escape(note);
  if (!press || !note.includes(press.match)) return html;
  return html.split(escape(press.match)).join(`<a class="press" href="${press.url}">${escape(press.match)}</a>`);
}

const skillsOf = (tech: string[]) => tech.map(slugify).join(' ');
const sp = p.side_projects;
---
<section class="section" id="experience" aria-labelledby="experience-title">
  <div class="container">
    <header class="section__head reveal">
      <h2 id="experience-title">Where I've shipped.</h2>
      <p class="section__lead">Rails and React in production since 2019: meal-delivery logistics for a cloud kitchen, therapy workflows for healthcare clients.</p>
    </header>
    <div class="career-wrap">
      <ol class="career reveal">
        <li class="career__row career__row--now">
          <p class="career__when">Now</p>
          <div class="career__body">
            <h3 class="career__company career__company--open">Open to new roles</h3>
            <p class="career__ask"><a class="link-arrow" href={`mailto:${p.email}`}>Tell me about the role <Icon name="arrow-right" px={16} /></a></p>
          </div>
        </li>
        {p.experience.map((job) => (
          <li class="career__row career__role" id={`role-${slugify(job.company)}`} data-role data-skills={skillsOf(job.positions.flatMap((pos) => pos.tech))}>
            <p class="career__when"><time datetime={isoMonth(job.start)}>{monthYear(job.start)}</time> – <time datetime={isoMonth(job.end)}>{monthYear(job.end)}</time> <span class="career__where">Remote</span></p>
            <div class="career__body">
              <h3 class="career__company">{job.company}</h3>
              {job.positions.map((pos) => (
                <div class="career__position">
                  <p class="career__title">{pos.title}</p>
                  <ul class="career__notes">
                    {pos.notes.map((note) => <li set:html={noteHtml(note, pos.press)} />)}
                  </ul>
                  <p class="career__stack">{pos.tech.map((t) => <span>{t}</span>)}</p>
                  {pos.system && (
                    <details class="career__system" id={`case-${pos.system.id}`} data-case={pos.system.id}>
                      <summary class="case__toggle"><span class="case__open">See the system</span><span class="case__close">Hide the system</span> <Icon name="arrow-down" px={16} /></summary>
                      <div class="career__system-body">
                        <p class="career__system-title">{pos.system.title}</p>
                        <Sketch nodes={pos.system.nodes} edges={pos.system.edges} />
                        <p class="career__system-text">{pos.system.text}</p>
                      </div>
                    </details>
                  )}
                </div>
              ))}
            </div>
          </li>
        ))}
        <li class="career__row career__role" id="role-side-projects" data-role data-skills={skillsOf(sp.tech)}>
          <p class="career__when">Since {sp.since}</p>
          <div class="career__body">
            <h3 class="career__company">{sp.title}</h3>
            <div class="career__position">
              <p class="career__text">{sp.text}</p>
              <p class="career__stack">{sp.tech.map((t) => <span>{t}</span>)}</p>
              <p class="career__links">
                <a class="career__link" href="#work">See Miru and Tlatoani <Icon name="arrow-down" px={15} /></a>
                <a class="career__link" href="#code">See the code <Icon name="arrow-down" px={15} /></a>
              </p>
            </div>
          </div>
        </li>
      </ol>

      <SkillSky id="skill-sky" follow />
    </div>
  </div>
</section>
