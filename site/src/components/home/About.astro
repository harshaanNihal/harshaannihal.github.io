---
import { profile as p } from '../../lib/data';
---
<section class="section section--alt" id="about" aria-labelledby="about-title">
  <div class="container">
    <header class="section__head reveal">
      <h2 id="about-title">Engineer, writer, lover of a good interface.</h2>
    </header>
    <div class="about__grid">
      <div class="about__text prose reveal">
        {p.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <dl class="facts reveal" style="--d:100ms">
        {p.about.facts.map((fact) => (
          <div class="facts__row">
            <dt>{fact.label}</dt>
            <dd>{fact.links
              ? fact.links.map((link, i) => <Fragment><a class={link.press ? 'press' : undefined} href={link.url}>{link.text}</a>{i < fact.links!.length - 1 && ', '}</Fragment>)
              : fact.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
