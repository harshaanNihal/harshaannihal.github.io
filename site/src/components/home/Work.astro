---
/* Case studies: the systems behind the roles, and two products built outside them, as rows of the index. Each
   row has its company as a big outlined name that inks in gold, the system's name, its dates, a short summary,
   its tools as stars, and a sketch of the system drawn as a constellation: the parts are stars and the dashed
   lines are how they connect. A part's label sits on the side away from its lines (above it, lines only run
   down; below it, only up, or level to a neighbour), so no line crosses a word. The case study (role, tools,
   outcome) opens in place in a details element, so it works without JavaScript; on a phone the sketch waits
   inside it. The Experience ledger links to each row by id. */
import { profile as p } from '../../lib/data';
import Icon from '../Icon.astro';
---
<section class="section section--alt" id="work" aria-labelledby="work-title">
  <div class="container">
    <header class="section__head reveal">
      <h2 id="work-title">The systems behind the roles.</h2>
      <p class="section__lead">Four from my jobs and two I built outside them. Open one for my role, the tools and what it did.</p>
    </header>
    <div class="index">
      {p.case_studies.map((c) => (
        <article class="index__item case reveal" id={`case-${c.id}`}>
          <h3 class="index__name">{c.company}</h3>
          <p class="case__title">{c.title}</p>
          <p class="index__kind">{c.when}</p>
          <p class="index__text">{c.summary}</p>
          {c.tools && <p class="index__stars">{c.tools.slice(0, 4).map((t) => <span>{t}</span>)}</p>}
          <details class="case__more">
            <summary class="case__toggle"><span class="case__open">Read the case study</span><span class="case__close">Close the case study</span> <Icon name="arrow-down" px={16} /></summary>
            <dl class="case__facts">
              <div><dt>Role</dt><dd>{c.role}</dd></div>
              {c.tools && <div><dt>Tools</dt><dd>{c.tools.join(', ')}</dd></div>}
              <div><dt>Outcome</dt><dd>{c.outcome}</dd></div>
            </dl>
            {c.links && (
              <ul class="index__links">
                {c.links.map((link) => <li><a class="link-arrow" href={link.url}>{link.text} <Icon name="arrow-up-right" px={16} /></a></li>)}
              </ul>
            )}
          </details>
          <figure class="case__sketch">
            <svg class="case__lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false"><g>
              {c.edges.map(([i0, i1], i) => {
                const a = c.nodes[i0]!;
                const b = c.nodes[i1]!;
                return <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} style={`--i:${i}`} />;
              })}
            </g></svg>
            {c.nodes.map((n, i) => <span class={`case__node case__node--${n.side}`} style={`--x:${n.x};--y:${n.y};--i:${i}`} aria-hidden="true">{n.label}</span>)}
            <figcaption class="visually-hidden">The parts of the system: {c.nodes.map((n) => n.label).join(', ')}.</figcaption>
          </figure>
        </article>
      ))}
    </div>
  </div>
</section>
