---
/* The ask, placed where a reader has seen the work and the writing and is deciding. */
import EmailCta from '../EmailCta.astro';
---
<section class="ask" aria-labelledby="ask-title">
  <div class="container ask__inner reveal">
    <div class="ask__text">
      <h2 id="ask-title">Hiring for Rails or React?</h2>
      <p class="lead">Tell me about the role.</p>
    </div>
    <EmailCta />
  </div>
</section>
