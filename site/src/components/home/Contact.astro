---
import { medium, profile as p } from '../../lib/data';
import Btn from '../Btn.astro';
import Icon from '../Icon.astro';
import Pstar from '../Pstar.astro';
import Swirl from '../Swirl.astro';
---
<section class="section contact" id="contact" aria-labelledby="contact-title" data-sky-host>
  <div class="contact__wash" aria-hidden="true"></div>
  <div class="sky" aria-hidden="true">
    <span class="stars"></span>
    <canvas class="sky__canvas" data-constellation></canvas>
    <Swirl id="contact" />
    <span class="moon"><Pstar class="pstar--moon" /><span class="moon__crescent"></span></span>
  </div>
  <div class="container contact__inner">
    <header class="section__head reveal">
      <h2 id="contact-title">Let's build something good.</h2>
      <p class="lead">Have a role, a project or a question in mind? My inbox is open.</p>
    </header>
    <div class="contact__actions reveal">
      <Btn href={`mailto:${p.email}`} label={p.email.replace('@', '<wbr>@')} icon="arrow-right" />
      <button class="btn btn--ghost btn--copy" type="button" data-copy={p.email}>
        <span class="copy-icon" aria-hidden="true"><Icon name="copy" /><Icon name="check" /></span>
        <span data-copy-label>Copy email</span>
      </button>
      <span class="visually-hidden" role="status" data-copy-status></span>
    </div>
    <ul class="social reveal" aria-label="Find me online">
      <li><a class="icon-btn" href={`https://github.com/${p.github}`} aria-label="GitHub"><Icon name="github" /></a></li>
      <li><a class="icon-btn" href={`https://www.linkedin.com/in/${p.linkedin}`} aria-label="LinkedIn"><Icon name="linkedin" /></a></li>
      <li><a class="icon-btn" href={medium.profile} aria-label="Medium"><Icon name="book-open" /></a></li>
      <li><a class="icon-btn" href={`https://twitter.com/${p.twitter}`} aria-label="Twitter"><Icon name="twitter" /></a></li>
    </ul>
  </div>
</section>
