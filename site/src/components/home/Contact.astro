---
/* The finale: the sky comes back around the ask, the address and the form. The footer below carries the links
   elsewhere, so they aren't repeated here. */
import ContactForm from '../ContactForm.astro';
import EmailCta from '../EmailCta.astro';
import Pstar from '../Pstar.astro';
import Swirl from '../Swirl.astro';
---
<section class="section contact" id="contact" aria-labelledby="contact-title" data-sky-host>
  <div class="contact__wash" aria-hidden="true"></div>
  <div class="sky" aria-hidden="true">
    <span class="stars"></span>
    <canvas class="sky__canvas" data-constellation></canvas>
    <Swirl id="contact" />
    <span class="moon"><Pstar class="pstar--moon" /><span class="moon__crescent"></span></span>
  </div>
  <div class="container contact__inner">
    <header class="section__head reveal">
      <h2 id="contact-title">Let's build something good.</h2>
      <p class="lead">Have a role, a project or a question in mind? My inbox is open.</p>
    </header>
    <EmailCta class="reveal" />
    <ContactForm />
  </div>
</section>
