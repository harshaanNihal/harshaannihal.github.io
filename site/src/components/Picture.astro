---
/* AVIF with a JPEG fallback, from a path under /assets/media with no extension. */
interface Props {
  src: string;
  alt: string;
  w: number;
  h: number;
}

const { src, alt, w, h } = Astro.props;
const base = `/assets/media/${src}`;
---
<picture><source type="image/avif" srcset={`${base}.avif`} /><img src={`${base}.jpg`} width={w} height={h} alt={alt} loading="lazy" decoding="async" /></picture>
