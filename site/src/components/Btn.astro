---
/* A button link. The notch variant (the default) is the action: a ring of beaten gold with sliding gaps. Ghost is the
   plaque: a plate in a frame-gold hairline. The label is a flex item that wraps, so a long label never overflows at
   320px, and may carry markup such as <wbr>. */
import Icon, { type IconName } from './Icon.astro';

interface Props {
  href: string;
  label: string;
  icon?: IconName;
  variant?: 'notch' | 'ghost';
  /** Open in a new tab. */
  ext?: boolean;
}

const { href, label, icon, variant = 'notch', ext = false } = Astro.props;
---
<a class={`btn btn--${variant}`} href={href} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined}><span class="btn__label" set:html={label} />{icon && <span class={`btn__icon btn__icon--${icon}`}><Icon name={icon} px={18} /></span>}</a>
