---
/* One repository as a GitHub row: name, one line, language and a live demo when there is one. */
import type { Repo } from '../lib/data';
import { slugify } from '../lib/format';
import Icon from './Icon.astro';

interface Props {
  repo: Repo;
}

const { repo } = Astro.props;
---
<li class="repo">
  <a class="repo__name" href={repo.url}>{repo.name}</a>
  <p class="repo__text">{repo.text}</p>
  <p class="repo__meta"><span class={`repo__lang repo__lang--${slugify(repo.language)}`}>{repo.language}</span>{repo.demo && <a class="link-arrow" href={repo.demo}>Live demo <Icon name="arrow-up-right" px={14} /></a>}</p>
</li>
