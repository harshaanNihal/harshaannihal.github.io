---
/* The end of the blog and of every post: who wrote it and how to reach him. */
import { profile } from '../lib/data';
import EmailCta from './EmailCta.astro';
---
<aside class="sign-off" aria-labelledby="sign-off-title">
  <div class="sign-off__portrait" aria-hidden="true">
    <picture><source type="image/avif" srcset="/assets/media/hero-480.avif" /><img src="/assets/media/hero-480.jpg" width="480" height="640" alt="" loading="lazy" decoding="async" /></picture>
  </div>
  <div class="sign-off__text">
    <h2 id="sign-off-title">{profile.name}</h2>
    <p>{profile.hero.eyebrow}. Hiring, or want to talk about something I wrote? Email me.</p>
  </div>
  <EmailCta />
</aside>
