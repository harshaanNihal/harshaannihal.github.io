---
/* The one action on every surface: the address as a notch button, with a Copy fallback for readers without a
   mail client. */
import { profile } from '../lib/data';
import Btn from './Btn.astro';
import Icon from './Icon.astro';
---
<div class="mail-actions">
  <Btn href={`mailto:${profile.email}`} label={profile.email.replace('@', '<wbr>@')} icon="arrow-right" />
  <button class="btn btn--ghost" type="button" data-copy={profile.email}>
    <span data-copy-icon><Icon name="copy" /></span>
    <span data-copy-label>Copy email</span>
  </button>
</div>
