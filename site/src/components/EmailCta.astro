---
/* The one action on every surface: the address as a notch button, with Copy beside it for readers without a
   mail client. Used by the ask, Contact, the blog and posts. */
import { profile } from '../lib/data';
import Btn from './Btn.astro';
import CopyEmail from './CopyEmail.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---
<div class:list={['mail-actions', className]}>
  <Btn href={`mailto:${profile.email}`} label={profile.email.replace('@', '<wbr>@')} icon="arrow-right" />
  <CopyEmail />
</div>
